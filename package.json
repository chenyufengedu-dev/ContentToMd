{
  "name": "content-to-md",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:format && npm run check:types && npm run check:lint && npm run test",
    "check:format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:types": "vue-tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml --quiet",
    "check:lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --quiet -- -D warnings",
    "test": "vitest run --passWithNoTests && cargo test --manifest-path src-tauri/Cargo.toml --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "lucide-vue-next": "^0.577.0",
    "motion": "14.5.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "type": "module"
}
