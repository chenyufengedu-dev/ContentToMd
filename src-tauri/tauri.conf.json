{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContentToMd",
  "version": "0.1.0",
  "identifier": "com.contenttomd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ContentToMd",
        "width": 1040,
        "height": 680,
        "center": true,
        "visible": false,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "publisher": "Caraxes",
    "copyright": "Copyright © 2026 Caraxes",
    "shortDescription": "把视频、截图、文档整理成 Markdown 笔记",
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "active": true,
    "resources": {
      "../src/assets/fonts/OFL.txt": "licenses/NotoSansSC-OFL.txt",
      "../LICENSE": "licenses/ContentToMd-MIT.txt"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
